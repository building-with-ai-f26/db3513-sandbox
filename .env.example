# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# NEVER commit your actual .env file to Git!

OPENROUTER_API_KEY=sk-or-v1-replace-with-your-key
TMDB_API_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# PostHog browser analytics (the project token is public; do not use a personal API key).
POSTHOG_PROJECT_TOKEN=phc_your_project_token
POSTHOG_HOST=https://your-posthog-host

# Set to true only on the public host. Gives each browser its own private profiles.
PUBLIC_DEPLOY=false
